# このファイルを .env.local という名前でコピーし、値を書き換えてください（.env.local は Git に含まれません）。
# 値を変えたら、npm run build でビルドし直すと反映されます。
# 未設定のあいだは、広告の位置に「広告スペース」の枠だけが表示されます。

# Google AdSense のパブリッシャーID
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx

# 広告ユニットID（AdSense 管理画面で広告ユニットを作成すると発行される data-ad-slot の数字）
# 一覧グリッドのインフィード広告
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
# 記事ページの「解説（意味）を見る」の下の広告
NEXT_PUBLIC_ADSENSE_SLOT_STORY=
